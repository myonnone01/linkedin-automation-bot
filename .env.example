# ============================================================
# LinkedIn Automation Bot - Configuration
# ============================================================
# Copy this file to `.env` and fill in your credentials.
# The `.env` file is git-ignored and never leaves your machine.
# ============================================================

# --- LinkedIn Sales Navigator credentials --------------------
# Used ONLY for initial login in the visible Chromium window.
# After the first login the session cookies are stored locally
# in .pw_profile/ and reused on subsequent runs.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# --- Anthropic Claude API ------------------------------------
# Get your key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for message generation. Claude Sonnet 4.6 is the
# current recommended model. Only change if you know what
# you're doing.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Flask web server ----------------------------------------
# 0.0.0.0 makes the UI reachable from your phone on the same
# Wi-Fi network. Change to 127.0.0.1 to restrict to localhost.
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# --- Safety caps ---------------------------------------------
# Daily message cap (LinkedIn's soft weekly invite limit is
# about 100-200, so keep daily well under 25 to stay safe).
DAILY_LIMIT=20

# Hard per-session cap. Regardless of daily_limit, never do
# more than this many actions in a single Start click.
SESSION_MAX_ACTIONS=25

# Humanized click-to-click delay range (seconds).
MIN_CLICK_DELAY_SEC=3
MAX_CLICK_DELAY_SEC=8

# Humanized profile-to-profile delay range (seconds).
MIN_PROFILE_DELAY_SEC=30
MAX_PROFILE_DELAY_SEC=60
